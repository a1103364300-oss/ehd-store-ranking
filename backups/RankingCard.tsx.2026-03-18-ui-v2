import { motion } from 'framer-motion';
import { TrendingUp, TrendingDown, Minus, Medal } from 'lucide-react';
import type { StoreRanking } from '../data/mockData';

interface RankingCardProps {
  store: StoreRanking;
  index: number;
}

export function RankingCard({ store, index }: RankingCardProps) {
  const isTop3 = store.rank <= 3;
  
  const getRankStyle = () => {
    switch (store.rank) {
      case 1: return 'rank-1';
      case 2: return 'rank-2';
      case 3: return 'rank-3';
      default: return 'rank-default';
    }
  };

  const getChangeIcon = () => {
    if (store.rankChange > 0) {
      return <TrendingUp className="w-4 h-4" />;
    } else if (store.rankChange < 0) {
      return <TrendingDown className="w-4 h-4" />;
    }
    return <Minus className="w-4 h-4" />;
  };

  const getChangeStyle = () => {
    if (store.rankChange > 0) return 'change-up';
    if (store.rankChange < 0) return 'change-down';
    return 'text-zinc-500';
  };

  const getMedalColor = () => {
    switch (store.rank) {
      case 1: return 'text-yellow-400';
      case 2: return 'text-zinc-300';
      case 3: return 'text-amber-600';
      default: return '';
    }
  };

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay: index * 0.05, duration: 0.3 }}
      className={`rank-card flex items-center gap-4 ${isTop3 ? 'ring-1 ring-zinc-700' : ''}`}
    >
      {/* 排名 */}
      <div className={`rank-badge ${getRankStyle()}`}>
        {store.rank}
      </div>

      {/* 门店信息 */}
      <div className="flex-1 min-w-0">
        <div className="flex items-center gap-2">
          {isTop3 && <Medal className={`w-5 h-5 ${getMedalColor()}`} />}
          <h3 className="font-semibold text-zinc-100 truncate">
            {store.storeName}
          </h3>
        </div>
        <div className="flex items-center gap-4 mt-1 text-sm text-zinc-400">
          <span className="font-mono">{store.orders.toLocaleString()} 单</span>
          <span>¥{store.revenue.toLocaleString()}</span>
          <span className="text-zinc-500">客单价 ¥{store.avgPrice.toFixed(0)}</span>
        </div>
      </div>

      {/* 排名变化 */}
      <div className={`flex items-center gap-1 font-mono text-sm ${getChangeStyle()}`}>
        {getChangeIcon()}
        {store.rankChange !== 0 && (
          <span className="font-semibold">
            {store.rankChange > 0 ? '+' : ''}{store.rankChange}
          </span>
        )}
      </div>
    </motion.div>
  );
}